MEDICLOUD_MACHINES_DB_PATH=./data/machines.db
MEDICLOUD_MACHINES_HTTP_ENABLED=true
MEDICLOUD_MACHINES_HTTP_HOST=localhost
MEDICLOUD_MACHINES_HTTP_PORT=5000
SERIAL_TRACE=false

# --- BioLabo Kenza 240TX (RS-232 serial by default) ---
# NOTE: these entries are documentation only. Machine config is stored per-profile
# in SQLite via the registry. Operators can use these as reference values for
# the frontend form fields when creating a Kenza profile.
#
# Connection mode: serial (direct RS-232) or tcp-bridge (serial-to-TCP bridge)
KENZA_TRANSPORT=serial
# Serial port the Kenza RS-232 cable is plugged into
KENZA_SERIAL_PORT=COM4
KENZA_SERIAL_BAUD=19200
KENZA_SERIAL_DATA_BITS=8
KENZA_SERIAL_STOP_BITS=1
KENZA_SERIAL_PARITY=n
KENZA_SERIAL_FLOW=none
KENZA_SERIAL_RECONNECT_MS=5000
# TCP bridge host and port (only used when KENZA_TRANSPORT=tcp-bridge)
KENZA_BRIDGE_HOST=127.0.0.1
KENZA_BRIDGE_PORT=9100
# Patient ID field width: 8 = Id8 variant, 9 = Id9 variant
KENZA_ID_LENGTH=9
# How often (ms) the LIS polls for pending orders and pushes them to the analyzer
KENZA_PUSH_INTERVAL_MS=5000
KENZA_ESTIMATED_MINUTES=15
# Enable verbose protocol logging (raw payloads, BCC values, push attempts)
KENZA_TRACE=false
